# ================================================================
# 仿真构建脚本
#
# 解决的问题：把「Verilog 源码 + C++ 测试平台」变成
#             「可执行程序 + 波形文件」，一条命令搞定。
#
# 在 sim/ 目录下执行：
#   make                   默认仿真 counter
#   make TOP=det101        仿真指定模块
#   make wave TOP=det101   编译、运行，再用 GTKWave 打开波形
#   make clean TOP=det101  删掉该模块的构建目录与波形
#
# 命名约定（必须遵守，否则找不到文件）：
#   soc/<TOP>.v            设计源文件
#   sim/<TOP>_main.cpp     C++ 测试平台
#
# 换模块只需在命令行给 TOP，本文件一个字都不用改。
# ================================================================


# ----------------------------------------------------------------
# 一、变量区
# ----------------------------------------------------------------
# 陷阱提醒：注释必须单独占一行。写成「TOP := counter  # 说明」时，
# 井号前面那些空格会变成变量值的一部分，后面路径就会拼错。

# 仓库根目录。
#   $(MAKEFILE_LIST)   make 读过的 Makefile 列表
#   $(lastword ...)    取最后一个，也就是本文件
#   $(dir ...)         取它所在目录
#   末尾 /..           退一级，得到 riscv-soc 根目录
#
# 这一行算出来永远是绝对路径，所以无论你用哪种方式调用：
#   cd sim && make              MAKEFILE_LIST = Makefile
#   make -C sim                 MAKEFILE_LIST = Makefile
#   make -f sim/Makefile        MAKEFILE_LIST = sim/Makefile
# 得到的 ROOT 都一样，都是 riscv-soc 的绝对路径。
#
# 注意：这不代表「在任何目录敲 make 都行」。
# make 本身只在「当前目录」找 Makefile，不会自己进 sim/。
# 在仓库根目录直接敲 make 会报 "No targets specified and no makefile found"，
# 必须用 cd、-C 或 -f 其中一种，把 make 指到这个文件上。
#
# 必须用绝对路径的原因：下面 --Mdir 把产物挪到 ~/vbuild 之后，
# 任何相对路径都会在新工作目录下解析而失败。
ROOT := $(abspath $(dir $(lastword $(MAKEFILE_LIST)))/..)

# ?= 表示「命令行没给值时才用默认值」。
# 所以 make TOP=det101 会覆盖默认的 counter，
# 后面所有引用 $(TOP) 的地方自动跟着变。这就是「不用改文件换模块」的原理。
TOP   ?= counter

# 源文件路径按命名约定自动推导
RTL   ?= $(ROOT)/soc/$(TOP).v
TB    ?= $(ROOT)/sim/$(TOP)_main.cpp

# 波形文件名。会落在仓库根目录，因为运行可执行文件前会先 cd 到根目录。
VCD   ?= $(TOP).vcd

# 编译中间产物放在 WSL 家目录，按模块名分目录。
# 原因：/mnt/f 是 Windows 盘，走 9p 协议，比 Linux 原生文件系统慢好几倍；
# Verilator 编译时会产生几十个中间文件，放这里快得多。
# 附带好处：仓库里永远不会有 obj_dir 残留。
BUILD ?= $(HOME)/vbuild/$(TOP)

# 传给 verilator 的参数：
#   --cc       生成 C++ 模型（核心动作：把 Verilog 翻译成 C++）
#   --exe      主程序由用户提供，不要自动生成 main
#   --build    翻译完直接调 g++ 编译链接，一步到底
#   --trace    在生成的代码里插入波形记录能力
#   -Wall      打开全部警告
# 故意不加 -Wno-fatal：警告即错误。早期的警告基本都是真问题
# （位宽截断、端口漏接），宁可被打断。
FLAGS := --cc --exe --build --trace -Wall

# 声明这三个是「动作」而不是文件名。
# 不声明的话，目录里若恰好有名为 clean 的文件，make 会以为已是最新而跳过。
.PHONY: all wave clean


# ----------------------------------------------------------------
# 二、默认目标 all：编译 + 运行
# ----------------------------------------------------------------
# 直接敲 make 时执行第一个目标。
#
# 五行分别做：
#   1. 检查设计文件在不在
#   2. 检查测试平台在不在
#   3. 建构建目录
#   4. 调 Verilator：翻译 + 编译 + 链接
#   5. 运行生成的可执行文件
# ----------------------------------------------------------------
all:
	@test -f $(RTL) || (echo "ERROR: 找不到 $(RTL)，检查 TOP 或文件命名"; exit 1)
	@test -f $(TB)  || (echo "ERROR: 找不到 $(TB)，检查 TOP 或文件命名";  exit 1)
	mkdir -p $(BUILD)
	cd $(ROOT) && verilator $(FLAGS) --top-module $(TOP) --Mdir $(BUILD) $(RTL) $(TB) -o V$(TOP)
	cd $(ROOT) && $(BUILD)/V$(TOP) $(VCD)


# ----------------------------------------------------------------
# 三、wave：在 all 的基础上多看一步波形
# ----------------------------------------------------------------
# 冒号后写 all 表示「先完成 all，再做下面这句」。
# 所以 make wave 会重新编译运行一遍，不是只打开旧波形。
# 只想看已有波形，直接 gtkwave det101.vcd 即可。
# ----------------------------------------------------------------
wave: all
	cd $(ROOT) && gtkwave $(VCD)


# ----------------------------------------------------------------
# 四、clean：清理
# ----------------------------------------------------------------
# 删掉该模块的构建目录和波形文件。
# 顺手清 obj_dir，防止某次没指定 --Mdir 留下的残渣。
# ----------------------------------------------------------------
clean:
	rm -rf $(BUILD)
	cd $(ROOT) && rm -rf obj_dir $(VCD)